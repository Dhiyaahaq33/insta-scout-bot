# Token Bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID Telegram akun Anda dari @userinfobot
TELEGRAM_CHAT_ID=

# API Key Google Gemini dari https://aistudio.google.com/
GEMINI_API_KEY=

# Personal Access Token GitHub (izin repo & workflow)
GITHUB_PAT=

# Nama repositori GitHub (default: Dhiyaahaq33/insta-scout-bot)
GITHUB_REPO=Dhiyaahaq33/insta-scout-bot

# (Opsional) Cookie string Instagram jika akun diprivat/kena login wall ketat
INSTAGRAM_COOKIES=
